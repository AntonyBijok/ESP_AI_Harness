# Local virtualenv used to run the acceptance suite
# (recreate with: python3 -m venv .venv && .venv/bin/pip install pytest requests pyserial esptool)
.venv/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Downloaded test-partner firmware bundles (recreate with ./fetch-test-partner.sh)
.fw/
.pr-upstream/

# Raw JSON captured from the live bench while writing the plugin API contract.
# Local evidence only; the observations it supports are quoted in
# TESTBENCH-PLUGIN-API.md.
.bench-samples/

# Scratch: probe scripts, log captures and subagent output produced while
# commissioning. Working notes, not deliverables.
.tmp/
